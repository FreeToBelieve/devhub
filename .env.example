# Optional. Defaults are used when no .env file exists.
DEVHUB_PORT=4317
DEVHUB_DB_PATH=.devhub/devhub.sqlite
DEVHUB_LOG_LEVEL=info

# Optional for Sprint 2.3. Use a dedicated, privately owned Codex account profile.
# DEVHUB_CODEX_HOME="/absolute/path/to/private/codex-profile"
# DEVHUB_CODEX_WORKTREE_ROOT=".devhub/codex-worktrees"
# DEVHUB_CODEX_PROVIDER_PROXY="http://127.0.0.1:7890"

# Optional Hub-only egress for GitHub and GitLab HTTPS. Use a trusted loopback CONNECT proxy.
# DEVHUB_GIT_HTTPS_PROXY="http://127.0.0.1:7890"

# Set this for a custom Unity Hub Editor root. Spaces in the path are supported.
# DEVHUB_UNITY_HUB_ROOT="D:\Unity Editors"
# DEVHUB_UNITY_PROJECT="/path/to/ShanHeWenXian/Unity"

# Optional Unity runtime storage and a trusted FFmpeg executable for capture.
# DEVHUB_UNITY_ARTIFACT_ROOT=".devhub/unity-runs"
# DEVHUB_UNITY_FFMPEG="/absolute/path/to/ffmpeg"
